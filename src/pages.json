{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "AI 英语卡",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/review/review",
      "style": {
        "navigationBarTitleText": "复习",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/quiz/quiz",
      "style": {
        "navigationBarTitleText": "自测",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/progress/progress",
      "style": {
        "navigationBarTitleText": "学习进度",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/search/search",
      "style": {
        "navigationBarTitleText": "词库",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/topic/topic",
      "style": {
        "navigationBarTitleText": "主题词表",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/import/import",
      "style": {
        "navigationBarTitleText": "我的单词",
        "navigationStyle": "custom"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "AI 英语卡",
    "navigationBarBackgroundColor": "#06080e",
    "backgroundColor": "#06080e"
  }
}