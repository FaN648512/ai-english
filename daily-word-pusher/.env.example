# 词库管理界面登录密码（务必修改为足够复杂的值）
ADMIN_PASSWORD=change-me-please

# 飞书群自定义机器人（优先使用）：飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 机器人开启「签名校验」时填写，未开启可留空
# FEISHU_SECRET=xxxxxxxx

# PushPlus（未配置飞书时使用）：https://www.pushplus.plus/ → 登录 → 一对一推送 → 复制 Token
PUSHPLUS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUSHPLUS_BASE_URL=https://www.pushplus.plus/send

# 企业微信群机器人 Webhook（未配置飞书 / PushPlus 时使用）
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# 可选：部署后的公网地址。仅用于在推送里额外附带网页版链接；
# 飞书卡片本身用折叠面板完成交互，不填也能正常「点单词看释义」。
# PUBLIC_BASE_URL=https://your-app.onrender.com

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 推送设置（默认值；网页「推送设置」里保存的值优先生效，保存后立即生效无需重启）
WORDS_PER_PUSH=5
PUSH_CRON=0 8 * * *
PUSH_TIMEZONE=Asia/Shanghai

# 外部定时器调用 /api/cron/push 时携带的密钥（可选，部署到会休眠的平台时建议开启）
# CRON_SECRET=random-long-string

# 服务端口与数据目录
PORT=3000
DATA_DIR=./data
